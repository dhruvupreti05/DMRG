    \PYG{n}{Sx\PYGZus{}R\PYGZus{}dense} \PYG{o}{=} \PYG{n}{Sx\PYGZus{}R}\PYG{o}{.}\PYG{n}{toarray}\PYG{p}{(}\PYG{p}{)}
    \PYG{n}{Sy\PYGZus{}R\PYGZus{}dense} \PYG{o}{=} \PYG{n}{Sy\PYGZus{}R}\PYG{o}{.}\PYG{n}{toarray}\PYG{p}{(}\PYG{p}{)}
    \PYG{n}{Sz\PYGZus{}R\PYGZus{}dense} \PYG{o}{=} \PYG{n}{Sz\PYGZus{}R}\PYG{o}{.}\PYG{n}{toarray}\PYG{p}{(}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} Perform projections ( dense matrix multiplication )}
    \PYG{n}{H\PYGZus{}new} \PYG{o}{=} \PYG{n}{Utr\PYGZus{}dense}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{p}{)}\PYG{o}{.}\PYG{n}{T} \PYG{o}{@} \PYG{n}{H\PYGZus{}left\PYGZus{}dense} \PYG{o}{@} \PYG{n}{Utr\PYGZus{}dense}
