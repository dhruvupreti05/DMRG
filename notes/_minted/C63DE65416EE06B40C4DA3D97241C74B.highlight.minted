        \PYG{n}{H\PYGZus{}left} \PYG{o}{+}\PYG{o}{=} \PYG{n}{kron}\PYG{p}{(}\PYG{n}{Sb}\PYG{p}{,} \PYG{n}{Ss}\PYG{p}{,} \PYG{n+nb}{format}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{csr}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} New right \PYGZhy{} edge operators (acting on the new site)}
