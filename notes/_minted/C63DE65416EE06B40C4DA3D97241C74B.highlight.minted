    \PYG{n}{evals}\PYG{p}{,} \PYG{n}{U} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{linalg}\PYG{o}{.}\PYG{n}{eigh}\PYG{p}{(}\PYG{n}{rho}\PYG{p}{)} \PYG{c+c1}{\PYGZsh{} Dense diagonalization (small matrix)}
    \PYG{n}{idx} \PYG{o}{=} \PYG{n}{np}\PYG{o}{.}\PYG{n}{argsort}\PYG{p}{(}\PYG{n}{evals}\PYG{p}{)}\PYG{p}{[}\PYG{p}{:}\PYG{p}{:}\PYG{o}{\PYGZhy{}}\PYG{l+m+mi}{1}\PYG{p}{]}\PYG{p}{[}\PYG{p}{:}\PYG{n}{n\PYGZus{}keep}\PYG{p}{]} \PYG{c+c1}{\PYGZsh{} Descending order}
    \PYG{n}{Utr} \PYG{o}{=} \PYG{n}{U}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,} \PYG{n}{idx}\PYG{p}{]}

