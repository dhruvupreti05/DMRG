\PYG{l+s+sd}{    \PYGZdq{}\PYGZdq{}\PYGZdq{}}

    \PYG{n}{m}\PYG{p}{,} \PYG{n}{d} \PYG{o}{=} \PYG{n}{block}\PYG{o}{.}\PYG{n}{dim}\PYG{p}{,} \PYG{l+m+mi}{2}

    \PYG{c+c1}{\PYGZsh{} (1) Build extended left block (block + new site)}
