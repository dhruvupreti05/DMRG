    \PYG{c+c1}{\PYGZsh{} Convert results back to sparse format}
    \PYG{n}{H\PYGZus{}new} \PYG{o}{=} \PYG{n}{csr\PYGZus{}matrix}\PYG{p}{(}\PYG{n}{H\PYGZus{}new}\PYG{p}{)}
