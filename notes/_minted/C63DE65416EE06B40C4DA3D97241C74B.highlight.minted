\PYG{k}{def}\PYG{+w}{ }\PYG{n+nf}{englarge\PYGZus{}block}\PYG{p}{(}\PYG{n}{block}\PYG{p}{:} \PYG{n}{Block}\PYG{p}{,} \PYG{n}{m\PYGZus{}keep}\PYG{p}{:} \PYG{n+nb}{int}\PYG{p}{)} \PYG{o}{\PYGZhy{}}\PYG{o}{\PYGZgt{}} \PYG{n+nb}{tuple}\PYG{p}{[}\PYG{n}{Block}\PYG{p}{,} \PYG{n+nb}{float}\PYG{p}{]}\PYG{p}{:}
\PYG{+w}{    }\PYG{l+s+sd}{\PYGZdq{}\PYGZdq{}\PYGZdq{}}
\PYG{l+s+sd}{    Add one site to block and truncate to m\PYGZus{}keep states using sparse matrices.}
