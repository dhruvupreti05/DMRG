    \PYG{n}{Sy\PYGZus{}new} \PYG{o}{=} \PYG{n}{Utr\PYGZus{}dense}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{p}{)}\PYG{o}{.}\PYG{n}{T} \PYG{o}{@} \PYG{n}{Sy\PYGZus{}R\PYGZus{}dense} \PYG{o}{@} \PYG{n}{Utr\PYGZus{}dense}
