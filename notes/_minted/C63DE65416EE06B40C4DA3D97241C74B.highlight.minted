        \PYG{n}{H\PYGZus{}super} \PYG{o}{+}\PYG{o}{=} \PYG{n}{kron}\PYG{p}{(}\PYG{n}{SL}\PYG{p}{,} \PYG{n}{SR}\PYG{p}{,} \PYG{n+nb}{format}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{csr}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} (4) Find superblock ground state}
    \PYG{n}{Evals}\PYG{p}{,} \PYG{n}{Psi} \PYG{o}{=} \PYG{n}{eigsh}\PYG{p}{(}\PYG{n}{H\PYGZus{}super}\PYG{p}{,} \PYG{n}{k}\PYG{o}{=}\PYG{l+m+mi}{1}\PYG{p}{,} \PYG{n}{which}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{SA}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{E0}\PYG{p}{,} \PYG{n}{psi0} \PYG{o}{=} \PYG{n}{Evals}\PYG{p}{[}\PYG{l+m+mi}{0}\PYG{p}{]}\PYG{p}{,} \PYG{n}{Psi}\PYG{p}{[}\PYG{p}{:}\PYG{p}{,} \PYG{l+m+mi}{0}\PYG{p}{]}

    \PYG{c+c1}{\PYGZsh{} (5) Compute reduced density matrix}
    \PYG{c+c1}{\PYGZsh{} Reshape wavefunction to bipartite form and compute density matrix}
    \PYG{n}{psi\PYGZus{}mat} \PYG{o}{=} \PYG{n}{psi0}\PYG{o}{.}\PYG{n}{reshape}\PYG{p}{(}\PYG{n}{mL}\PYG{p}{,} \PYG{n}{mR}\PYG{p}{)}
    \PYG{n}{rho} \PYG{o}{=} \PYG{n}{psi\PYGZus{}mat} \PYG{o}{@} \PYG{n}{psi\PYGZus{}mat}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{p}{)}\PYG{o}{.}\PYG{n}{T}
    \PYG{n}{rho} \PYG{o}{=} \PYG{p}{(}\PYG{n}{rho} \PYG{o}{+} \PYG{n}{rho}\PYG{o}{.}\PYG{n}{conj}\PYG{p}{(}\PYG{p}{)}\PYG{o}{.}\PYG{n}{T}\PYG{p}{)}\PYG{o}{/}\PYG{l+m+mi}{2} \PYG{c+c1}{\PYGZsh{} Ensure Hermiticity}

