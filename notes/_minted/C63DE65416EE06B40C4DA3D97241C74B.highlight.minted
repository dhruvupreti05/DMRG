    \PYG{n}{left\PYGZus{}block} \PYG{o}{=} \PYG{n}{Block}\PYG{p}{(}\PYG{n}{m} \PYG{o}{*} \PYG{n}{d}\PYG{p}{,} \PYG{n}{H\PYGZus{}left}\PYG{p}{,} \PYG{p}{(}\PYG{n}{Sx\PYGZus{}R}\PYG{p}{,} \PYG{n}{Sy\PYGZus{}R}\PYG{p}{,} \PYG{n}{Sz\PYGZus{}R}\PYG{p}{)}\PYG{p}{)}

    \PYG{c+c1}{\PYGZsh{} (2) Build environment block (mirror of left block)}
    \PYG{c+c1}{\PYGZsh{} For reflection symmetry , environment uses same operators as left block}
    \PYG{n}{env\PYGZus{}block} \PYG{o}{=} \PYG{n}{left\PYGZus{}block}
    \PYG{n}{mL}\PYG{p}{,} \PYG{n}{mR} \PYG{o}{=} \PYG{n}{left\PYGZus{}block}\PYG{o}{.}\PYG{n}{dim}\PYG{p}{,} \PYG{n}{env\PYGZus{}block}\PYG{o}{.}\PYG{n}{dim} \PYG{c+c1}{\PYGZsh{} mL = mR = 2 * m}
    \PYG{n}{I\PYGZus{}L} \PYG{o}{=} \PYG{n}{eye}\PYG{p}{(}\PYG{n}{mL}\PYG{p}{,} \PYG{n+nb}{format}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{csr}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}
    \PYG{n}{I\PYGZus{}R} \PYG{o}{=} \PYG{n}{eye}\PYG{p}{(}\PYG{n}{mR}\PYG{p}{,} \PYG{n+nb}{format}\PYG{o}{=}\PYG{l+s+s1}{\PYGZsq{}}\PYG{l+s+s1}{csr}\PYG{l+s+s1}{\PYGZsq{}}\PYG{p}{)}

